# Training outputs — large + reproducible from training/train_open_default.py.
# Only the trained ONNX gets attached to a GitHub Release; the working
# dirs stay local. The `!training/logs/` un-ignore overrides the broader
# `logs/` rule earlier in this file (which would otherwise hide the
# training/logs subtree entirely).
!training/logs/
!training/models/
!training/tmp/
!training/configs/
training/logs/*
!training/logs/.gitkeep
training/models/*
!training/models/.gitkeep
training/tmp/*
!training/tmp/.gitkeep
training/configs/*
!training/configs/.gitkeep
# Preset profile configs ARE source (drive generate_preset_bundles.py + tests).
!training/configs/presets/
!training/configs/presets/*.json

# Bridge runtime state generated at first boot — never commit.
src/sigrift/bridge/data/.mac_secret
src/sigrift/bridge/data/*.json
src/sigrift/bridge/data/*.key
src/sigrift/bridge/data/*.txt

# Local review/analysis artifacts — may contain pre-scrub material.
/reports/

# Managed local scanner selection (contains hardware identities, no keys)
.sigrift-scanners.yml
.sigrift-scanners-*.yml

# Atomic nonsecret desired scanner selection retained across setup failures.
.sigrift-scanners-pending.json
.sigrift-scanners-pending-*.json

# Local agent worktrees and stray coverage output
.claude/
/coverage/
lcov.info
tests/bridge/js/coverage/
