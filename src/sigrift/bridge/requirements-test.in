# Bridge test-only dependencies (pytest, plugins and ONNX integration).
# Not installed in the
# production image. Edit this file, then run scripts/lock-requirements.sh,
# which regenerates the hashed requirements-test.txt — pinned to the same
# versions as requirements.txt for anything both need.
#
# Tests and CI install both locks plus torch:
#
#   pip install --require-hashes \
#       -r src/sigrift/bridge/requirements.txt \
#       -r src/sigrift/bridge/requirements-test.txt
#   pip install --require-hashes --no-deps \
#       -r src/sigrift/bridge/requirements-torch-cpu.txt

