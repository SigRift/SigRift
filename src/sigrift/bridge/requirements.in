# The Bridge — runtime dependencies (the ones the code imports directly).
#
# This is the file to edit. requirements.txt is generated from it — every
# package pinned with sha256 hashes — by scripts/lock-requirements.sh,
# which also regenerates requirements-test.txt and the torch locks. Install
# from the locks, never from this file:
#
#   pip install --require-hashes -r src/sigrift/bridge/requirements.txt
#   pip install --require-hashes --no-deps \
#       -r src/sigrift/bridge/requirements-torch-cpu.txt
#
# Everything here comes from PyPI only. Torch is NOT listed: the CPU wheel
# lives on the PyTorch index, and mixing two indexes in one install lets
# pip take a same-named package from either (the dependency-confusion
# shape). It is installed in a separate step, from that index only, with
# --no-deps (requirements-torch-cpu.txt) — which is why torch's own
# runtime dependencies are listed at the end of this file.
#
# Keep Python 3.11 support (the images run python:3.11-slim).

fastapi==0.136.3
uvicorn==0.40.0
# WebSocket protocol implementation for uvicorn — without this, the
# dashboard's /api/*/ws/* endpoints return 404 with "Unsupported upgrade
# request" because uvicorn ships without a WS handler unless installed
# via [standard] extras or paired with websockets/wsproto explicitly.
websockets==16.0
